import math
import tkinter as tk

#Creating a GUI window calculator using tkinter
root = tk.Tk()
root.title("First GUI")
root.geometry("400x600")

#Initializing the global calulation string
calculation = ""

#Creating a global variable to store the calculation
text_result = tk.Text(root, height=3, width=30, font=("Arial", 24))
text_result.grid(row=0, columnspan=4)

#Creating a function to add the symbol to the calculation and update the text_result widget
def add_to_calculation(symbol):
    global calculation
    calculation += str(symbol)
    text_result.delete(1.0, "end")
    text_result.insert(1.0, calculation)

#Creating a function to clear the calculation and update the text_result widget
def clear_calculation():
    global calculation
    calculation = ""
    text_result.delete(1.0, "end")

#Creating a safe dictionary of allowed functions and constants from the math module
safe_dictionary = {
    "sqrt": math.sqrt,
    "sin": math.sin,
    "cos": math.cos,
    "tan": math.tan,
    "log": math.log,
    "pi": math.pi,
    "e": math.e
}

#Creating a function to evaluate the calculation and update the text_result widget
def eval_calculation():
    global calculation

    #Evaluating the user input in a safe environment
    try:
        result = str(eval(calculation, safe_dictionary))
        calculation = result
        text_result.delete(1.0, "end")
        text_result.insert(1.0, result)
    #If the user tries to divide by zero, print an error message
    except ZeroDivisionError:
        text_result.delete(1.0, "end")
        text_result.insert(1.0, "Error")
        calculation = ""
    #If the user does a math domain error, print an error message
    except ValueError as e:
        text_result.delete(1.0, "end")
        text_result.insert(1.0, f"Error: {e}")
        calculation = ""
    #If the user inputs invalid syntax, print an error message
    except SyntaxError:
        text_result.delete(1.0, "end")
        text_result.insert(1.0, "Error")
        calculation = ""
    #If there is any other unknown error, print an error message
    except Exception as e:
        text_result.delete(1.0, "end")
        text_result.insert(1.0, f"Error: {e}")
        calculation = ""
    except:
        clear_calculation()
        text_result.delete(1.0, "end")
        calculation = ""

#Creating buttons with the numbers 0-9
#We use lambda functions to pass the number to the add_to_function function when the button is clicked and not a second earlier
btn_1 = tk.Button(root, text='1', command=lambda: add_to_calculation('1'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_1.grid(row=3, column =0)
btn_2 = tk.Button(root, text='2', command=lambda: add_to_calculation('2'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_2.grid(row=3, column =1)
btn_3 = tk.Button(root, text='3', command=lambda: add_to_calculation('3'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_3.grid(row=3, column =2)
btn_4 = tk.Button(root, text='4', command=lambda: add_to_calculation('4'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_4.grid(row=4, column =0)
btn_5 = tk.Button(root, text='5', command=lambda: add_to_calculation('5'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_5.grid(row=4, column =1)
btn_6 = tk.Button(root, text='6', command=lambda: add_to_calculation('6'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_6.grid(row=4, column =2)
btn_7 = tk.Button(root, text='7', command=lambda: add_to_calculation('7'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_7.grid(row=5, column =0)
btn_8 = tk.Button(root, text='8', command=lambda: add_to_calculation('8'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_8.grid(row=5, column =1)
btn_9 = tk.Button(root, text='9', command=lambda: add_to_calculation('9'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_9.grid(row=5, column =2)
btn_0 = tk.Button(root, text='0', command=lambda: add_to_calculation('0'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_0.grid(row=6, column =1)

#Creating the buttons for the operations
btn_add = tk.Button(root, text='+', command = lambda: add_to_calculation('+'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_add.grid(row=3, column=3)
btn_subtract = tk.Button(root, text='-', command = lambda: add_to_calculation('-'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_subtract.grid(row=4, column=3)
btn_multiply = tk.Button(root, text='*', command = lambda: add_to_calculation('*'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_multiply.grid(row=5, column=3)
btn_divide = tk.Button(root, text='/', command = lambda: add_to_calculation('/'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_divide.grid(row=6, column=3)
btn_decimal = tk.Button(root, text='.', command = lambda: add_to_calculation('.'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_decimal.grid(row=6, column=0)
btn_clear = tk.Button(root, text='C', command = clear_calculation, width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_clear.grid(row=1, column=3)
btn_equals = tk.Button(root, text='=', command = eval_calculation, width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_equals.grid(row=2, column=3)
btn_sqrt = tk.Button(root, text='√', command = lambda: add_to_calculation('sqrt('), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_sqrt.grid(row=2, column=0)
btn_sin = tk.Button(root, text='sin', command = lambda: add_to_calculation('sin('), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_sin.grid(row=1, column=0)
btn_cos = tk.Button(root, text='cos', command = lambda: add_to_calculation('cos('), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_cos.grid(row=1, column=1)
btn_tan = tk.Button(root, text='tan', command = lambda: add_to_calculation('tan('), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_tan.grid(row=1, column=2)
btn_log = tk.Button(root, text='log', command = lambda: add_to_calculation('log('), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_log.grid(row=2, column=1)
btn_pi = tk.Button(root, text='π', command = lambda: add_to_calculation('pi'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_pi.grid(row=2, column=2)
btn_e = tk.Button(root, text='e', command = lambda: add_to_calculation('e'), width=4, height=1, font=("Arial", 24), bd=0, relief="flat")
btn_e.grid(row=6, column=2)

root.mainloop()